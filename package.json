{
  "name": "said-and-done",
  "version": "0.1.0",
  "description": "See the prompt behind every line of code: link AI coding-agent sessions to git history and render a Build Story.",
  "keywords": [
    "ai",
    "provenance",
    "claude-code",
    "coding-agent",
    "git",
    "prompts",
    "build-story",
    "voice",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/darain24/said-and-done#readme",
  "bugs": {
    "url": "https://github.com/darain24/said-and-done/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darain24/said-and-done.git"
  },
  "license": "MIT",
  "author": "darain24",
  "type": "module",
  "bin": {
    "said": "dist/cli.js"
  },
  "files": [
    "dist",
    "said.config.schema.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web && node --import tsx scripts/build-template.ts && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev": "npm run dev --workspace web",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace web",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 \"test/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
